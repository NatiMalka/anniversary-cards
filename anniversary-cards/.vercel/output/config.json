{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"continue": false
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/admin/?(?:/__data.json)?$",
			"dest": "/admin"
		},
		{
			"src": "^/admin/card-editor/?(?:/__data.json)?$",
			"dest": "/admin/card-editor"
		},
		{
			"src": "^/admin/cleanup/?(?:/__data.json)?$",
			"dest": "/admin/cleanup"
		},
		{
			"src": "^/admin/tasks/?(?:/__data.json)?$",
			"dest": "/admin/tasks"
		},
		{
			"src": "^/album/?(?:/__data.json)?$",
			"dest": "/album"
		},
		{
			"src": "^/anniversary/?(?:/__data.json)?$",
			"dest": "/anniversary"
		},
		{
			"src": "^/auth/logout/?(?:/__data.json)?$",
			"dest": "/auth/logout"
		},
		{
			"src": "^/login/?(?:/__data.json)?$",
			"dest": "/login"
		},
		{
			"src": "^/pack-test/?(?:/__data.json)?$",
			"dest": "/pack-test"
		},
		{
			"src": "^/packs/?(?:/__data.json)?$",
			"dest": "/packs"
		},
		{
			"src": "^/tasks/?(?:/__data.json)?$",
			"dest": "/tasks"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}